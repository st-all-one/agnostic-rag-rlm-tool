{
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "rlm_search",
        "description": "Search the project knowledge base using hybrid BM25+semantic search. Returns ranked chunks with file paths, line numbers, and relevance scores.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Search query (natural language or code identifiers)"
            },
            "top_k": {
              "type": "integer",
              "description": "Number of results to return (default: 10)",
              "default": 10
            },
            "file_pattern": {
              "type": "string",
              "description": "Filter results by file path substring (e.g. 'src/auth')"
            },
            "min_score": {
              "type": "number",
              "description": "Minimum relevance score threshold (0.0-1.0)"
            },
            "project": {
              "type": "string",
              "description": "Project path (default: current directory)"
            }
          },
          "required": ["query"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "rlm_context",
        "description": "Build context for an agent task by searching the project knowledge base. Returns formatted context chunks optimized for LLM consumption.",
        "parameters": {
          "type": "object",
          "properties": {
            "task": {
              "type": "string",
              "description": "Task description, question, or what context is needed"
            },
            "top_k": {
              "type": "integer",
              "description": "Number of context chunks to return (default: 10)",
              "default": 10
            },
            "project": {
              "type": "string",
              "description": "Project path (default: current directory)"
            }
          },
          "required": ["task"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "rlm_run",
        "description": "Run recursive language model analysis on a complex task. Requires an LLM backend. Decomposes the task into sub-queries and explores the codebase iteratively.",
        "parameters": {
          "type": "object",
          "properties": {
            "task": {
              "type": "string",
              "description": "Complex task to analyze recursively"
            },
            "backend": {
              "type": "string",
              "enum": ["openai", "anthropic", "ollama", "gemini"],
              "description": "LLM backend to use (default: ollama)"
            },
            "model": {
              "type": "string",
              "description": "Model name for the chosen backend"
            },
            "depth": {
              "type": "integer",
              "description": "Maximum recursion depth (default: 3)",
              "default": 3
            },
            "max_nodes": {
              "type": "integer",
              "description": "Maximum number of nodes to visit (default: 50)",
              "default": 50
            },
            "concurrency": {
              "type": "integer",
              "description": "Concurrency limit for parallel exploration (default: 4)",
              "default": 4
            },
            "max_budget": {
              "type": "number",
              "description": "Maximum budget in USD (default: 1.0)",
              "default": 1.0
            },
            "project": {
              "type": "string",
              "description": "Project path (default: current directory)"
            }
          },
          "required": ["task"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "rlm_index",
        "description": "Index a project directory into the knowledge base. Chunks files, computes embeddings, and stores them for search. Must be run before search/context.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Directory to index (default: current directory)"
            },
            "chunk_size": {
              "type": "integer",
              "description": "Maximum tokens per chunk (default: 512)",
              "default": 512
            },
            "project": {
              "type": "string",
              "description": "Project name for storage (default: directory name)"
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "rlm_status",
        "description": "Show status of indexed projects and their chunk/file counts. Use to verify indexing state before search.",
        "parameters": {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "description": "Optional run ID to check specific run status"
            },
            "project": {
              "type": "string",
              "description": "Project path (default: current directory)"
            }
          },
          "required": []
        }
      }
    }
  ]
}
